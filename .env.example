# Public site URL used for canonical links, sitemap and emails.
# Production canonical is always https://mohaotech.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Search Console HTML-tag token. Do not invent a value.
# Add a Domain property in Google Search Console (DNS TXT on Cloudflare) instead,
# or paste the meta-tag token here and redeploy.
# GOOGLE_SITE_VERIFICATION=

# PostgreSQL connection string
DATABASE_URL=postgresql://mohao:mohao@localhost:5432/mohao_tech

# Secret used to sign admin session cookies (use a long random string in production)
AUTH_SECRET=replace-with-a-long-random-secret

# Seeded administrator (used only by `pnpm db:seed`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Business inbox that receives new enquiry notifications
BUSINESS_EMAIL=hello@example.com

# From address shown on outgoing mail
EMAIL_FROM="Mohao Tech <hello@example.com>"

# console | smtp | resend
EMAIL_PROVIDER=console

# SMTP (required when EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Resend (required when EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# Yoco Checkout. Secret key from the Yoco app, Sales -> Payment Gateway.
# Webhook secret is returned once when you register
# https://mohaotech.com/api/yoco/webhook
# Leave both empty until you have them. Do not commit the real values.
YOCO_SECRET_KEY=
YOCO_WEBHOOK_SECRET=
