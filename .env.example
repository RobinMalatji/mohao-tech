# Public site URL used for canonical links, sitemap and emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection string
DATABASE_URL=postgresql://mohao:mohao@localhost:5432/mohao_tech

# Secret used to sign admin session cookies (use a long random string in production)
AUTH_SECRET=replace-with-a-long-random-secret

# Seeded administrator (used only by `pnpm db:seed`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Business inbox that receives new enquiry notifications
BUSINESS_EMAIL=hello@example.com

# From address shown on outgoing mail
EMAIL_FROM="Mohao Tech <hello@example.com>"

# console | smtp | resend
EMAIL_PROVIDER=console

# SMTP (required when EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Resend (required when EMAIL_PROVIDER=resend)
RESEND_API_KEY=
